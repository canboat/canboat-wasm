{
  "name": "@canboat/wasm",
  "version": "8.0.0-beta3",
  "description": "WebAssembly build of the canboat NMEA 2000 decoder/encoder — the canboat wire brain as a pure-npm, in-process package.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "pkg/"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --release --target nodejs && rm -f pkg/.gitignore",
    "build:ts": "tsup",
    "build": "npm run build:wasm && npm run build:ts",
    "typecheck": "tsc",
    "test": "node test/smoke.mjs && node test/smoke.cjs",
    "prepack": "npm run build",
    "format": "prettier --write . && eslint --fix",
    "ci-lint": "eslint && prettier --check ."
  },
  "repository": "https://github.com/canboat/canboat-wasm",
  "license": "Apache-2.0",
  "dependencies": {
    "@canboat/ts-pgns": "1.11.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.6.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
