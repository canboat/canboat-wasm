{
  "compilerOptions": {
    // tsup's dts step injects a baseUrl into its synthesized tsconfig,
    // which TypeScript 6 rejects as deprecated (TS5101). Nothing in
    // this file uses deprecated options — drop this once tsup stops
    // injecting baseUrl.
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["ts/**/*.ts"]
}
